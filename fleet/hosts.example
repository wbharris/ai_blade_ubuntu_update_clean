# Inventory for update-clean-fleet.sh
# One host per line. Blank lines and # comments are ignored.
#
# Formats:
#   hostname
#   user@hostname
#   user@hostname:port
#   user@ip
#
# Examples for a SuperPOD-style rack (replace with your names):
#
# dgx-a100-01
# dgx-a100-02
# ubuntu@blade-03
# root@10.20.30.40:22
#
# Or use a BCM category expansion — see bcm/ and --from-bcm-category

# node001
# node002
# node003
