# Optional configuration for update-clean.sh (AI / GPU blades)
# Copyright (C) 2026 wbharris
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Copy to one of:
#   /etc/update-clean.conf
#   ~/.config/update-clean.conf
#   ~/.update-clean.conf

# Number of log files to retain (default: 3)
# LOG_RETENTION=10

# Newest extra kernels to keep besides the running one (default: 2, max 10).
# Example: KERNEL_KEEP=2 keeps running + the 2 newest other linux-image packages.
# KERNEL_KEEP=2

# Optional path overrides
# LOG_DIR=/var/log/update-clean
# LOCKFILE=/run/update-clean.lock
# LAST_RUN_DIR=/var/lib/update-clean

# Backup /etc before purging residual configs (default: false)
# BACKUP_MODE=true

# Reboot automatically when /var/run/reboot-required is set (default: false)
# Still blocked if GPU compute processes are running (process exit 2, not 1)
# REBOOT_IF_REQUIRED=false

# Abort before apt when GPU compute jobs are running (default: true, exit 3).
# Set false or pass --no-skip-if-gpu-busy to upgrade a busy node anyway.
# SKIP_IF_GPU_BUSY=true

# Skip fwupd firmware updates (default: true on AI/GPU blades)
# Prefer site or vendor firmware workflows on managed fleets
# SKIP_FIRMWARE=true

# Hold GPU/accelerator packages during cleanup (default: true)
# HOLD_GPU=true
# HOLD_NVIDIA=true   # deprecated alias for HOLD_GPU

# Docker image prune: none | dangling | unused (default: dangling)
# unused also drops stopped containers and unused networks. Avoid on shared image caches.
# DOCKER_PRUNE=dangling

# journalctl vacuum window (default: 30d)
# JOURNAL_VACUUM_TIME=14d

# Verbosity: quiet | normal | verbose (default: normal)
# VERBOSITY=normal
# Max apt lines on console in normal mode (0 = unlimited; full log always in APT_LOG)
# CONSOLE_APT_MAX_LINES=80

# Kernel package filters (ERE for grep -Ev). Defaults exclude meta/debug/cloud variants.
# KERNEL_SUFFIX_EXCLUDE_REGEX='-(meta|dbg|dbgsym|rt|cloud|kvm|virtual)$'
# KERNEL_META_EXCLUDE_REGEX='linux-image-(generic|generic-hwe|amd64)(-lts|-hwe)?$'

# APT lock wait (seconds) when another apt/dpkg process holds locks.
# Install psmisc (fuser) or lsof so holders can be detected; without them
# leftover lock files are treated as unknown, not held. 0 = fail immediately.
# APT_LOCK_WAIT_SECS=60
# APT_LOCK_POLL_SECS=5

# Vendor GPU CLI hang protection (seconds)
# GPU_CLI_TIMEOUT_SECS=10

# Optional completion email (requires mail command)
# ADMIN_EMAIL=ops@example.com

# Packages to hold during cleanup (default: base-files base-passwd bash coreutils util-linux)
# CRITICAL_PACKAGES=(base-files base-passwd bash coreutils util-linux)

# Recommended host packages (not required to start):
#   psmisc or lsof  — APT lock-holder PIDs
#   coreutils timeout — cap vendor GPU CLI hangs
#   jq              — preferred last-run.json encoder (builtin fallback if missing)
# Optional when already present: nvidia-smi, rocm-smi, fwupdmgr, docker, snap, flatpak

# Tests / CI: write logs under $TMPDIR instead of /var/log (also honors CI=true)
# UPDATE_CLEAN_SKIP_LOGS=true

# One-shot CLI overrides (not extra config keys):
#   --no-kernel            skip kernel cleanup for this run
#   --with-firmware        allow fwupd this run
#   --reboot-if-required   reboot if /var/run/reboot-required is set
#   --offline              skip the network check
# /etc/update-clean.conf must be owned by root when installed system-wide.
